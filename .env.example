# Copy this file to .env and adjust as needed. All values are optional —
# sane defaults are used if a variable is missing.

# Path to the Stockfish binary. Defaults to engine/stockfish.exe (see README
# for how to download it — it's gitignored, too big for GitHub).
STOCKFISH_PATH=engine/stockfish.exe

# Port the local web app listens on.
PORT=5000

# Chess.com username whose style model to load (must exist under models/
# as <username>_policy.pt). Can also be passed as a CLI arg: python app.py <username>
# "demo" ships pre-trained in this repo so you can try it immediately;
# swap in your own once you've trained one (see README step 1-2).
CHESS_USERNAME=demo
